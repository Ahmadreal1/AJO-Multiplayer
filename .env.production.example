# AJO production environment template (v1.4)
# Copy to a secret store or private .env on the server. NEVER commit real values.

PORT=3000
NODE_ENV=production

# --- Gate 1: PostgreSQL ---
AJO_REPOSITORY=postgres
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
AJO_AUTO_MIGRATE=0

# --- Gate 2: Sessions + HTTPS proxy ---
SESSION_SECRET=REPLACE_WITH_OPENSSL_RAND_HEX_32
TRUST_PROXY=1
AJO_HSTS=1
CORS_ORIGIN=https://YOUR_REAL_ORIGIN.EXAMPLE

# --- Operational limits ---
AJO_MAX_ROOM_PLAYERS=100
AJO_ROOM_TTL_HOURS=24
AJO_SESSION_TTL_HOURS=24
AJO_RATE_LIMIT_WINDOW_MS=60000
AJO_RATE_LIMIT_MAX=60
AJO_RATE_LIMIT_VOTE_MAX=20
AJO_RATE_LIMIT_JOIN_MAX=15
