PORT=3000
AJO_MAX_ROOM_PLAYERS=100
AJO_ROOM_TTL_HOURS=24
AJO_RATE_LIMIT_WINDOW_MS=60000
AJO_RATE_LIMIT_MAX=60
AJO_RATE_LIMIT_VOTE_MAX=20
AJO_RATE_LIMIT_JOIN_MAX=15
AJO_SESSION_TTL_HOURS=24

# Repository selection: "json" (default) or "postgres"
AJO_REPOSITORY=json

# Required for postgres. Never commit real credentials.
# DATABASE_URL=postgres://user:password@host:5432/ajo?sslmode=require
# AJO_AUTO_MIGRATE=1

# Production session signing secret (min 16 chars). Required for durable sessions.
# SESSION_SECRET=change-me-to-a-long-random-string

# Behind HTTPS terminator / reverse proxy:
# TRUST_PROXY=1
# AJO_HSTS=1
# CORS_ORIGIN=https://your-domain.example
